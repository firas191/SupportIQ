# PostgreSQL
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=firas
POSTGRES_DB=supportiq

# RabbitMQ
RABBITMQ_DEFAULT_USER=supportiq
RABBITMQ_DEFAULT_PASS=firas

# JWT (backend) — DOIT faire au moins 32 octets (256 bits) pour HS256
JWT_SECRET=generate-a-long-random-secret-at-least-32-bytes-please

# Premier compte ADMIN amorce au demarrage (seeder idempotent).
# Laisser vide en prod pour desactiver le seeding automatique.
ADMIN_EMAIL=admin@supportiq.local
ADMIN_PASSWORD=firas
ADMIN_FULL_NAME=Administrateur SupportIQ

# LLM providers (au moins un requis ; failover dans cet ordre)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
# Empiler plusieurs comptes pour contourner les quotas quotidiens (le générateur d'eval bascule
# automatiquement au 429) : suffixes numérotés OU liste séparée par des virgules. Ex :
# GROQ_API_KEY_2=gsk_deuxieme_compte
# GROQ_API_KEY=gsk_compte_a,gsk_compte_b

# Seuil d'escalade LLM du routeur de confiance
CONFIDENCE_THRESHOLD=0.80

# Budgets de jetons **par execution d'agent** (S6-J5). Ce ne sont pas des quotas journaliers : ils
# protegent d'une boucle malheureuse sur un cas particulier. Un run qui les atteint est anormal.
# Laisser vide pour utiliser les defauts du code (voir app/config.py).
# BUDGET_RESOLUTION_TOKENS=20000
# BUDGET_INSIGHT_TOKENS=12000
# BUDGET_DIGEST_TOKENS=8000
# BUDGET_TRIAGE_TOKENS=4000

# Observabilite LLM (S3-J5) : traces Langfuse. Laisser vide pour desactiver (no-op).
# Cles obtenues dans l'UI Langfuse (self-host sur http://localhost:3000 ou cloud).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Webhook d'ingestion temps reel (S2-J4) : cle API + secret HMAC partages avec l'appelant.
WEBHOOK_API_KEY=dev-webhook-key
WEBHOOK_SECRET=dev-webhook-secret-change-in-prod

# Agent Insight, text-to-SQL (S6-J1).
# Mot de passe du role PostgreSQL `insight_ro`, cree par la migration V11. Ce role n'a le droit de
# lire que six vues d'agregats et ne peut rien ecrire : c'est la seconde barriere, celle qui tient
# meme si la validation AST est contournee (ADR-0007).
# Consomme deux fois : par Flyway (placeholder, cote backend) et par le service IA (connexion).
INSIGHT_DB_PASSWORD=insight

# Synthese hebdomadaire (S6-J4).
# DIGEST_RECIPIENTS vide = **aucun envoi** : la synthese est generee et consultable dans
# l'interface, mais aucun courriel ne part. Defaut volontaire — un environnement de test ne doit
# pas pouvoir ecrire a de vraies personnes par accident.
# Renseigner une adresse active l'envoi ; en developpement il part vers Mailpit (voir ci-dessous),
# qui capture le message au lieu de le livrer.
DIGEST_RECIPIENTS=
DIGEST_FROM=supportiq@localhost

# Sujets emergents (S7-J1).
# Detection nocturne (3 h 30) : regroupement des tickets recents par ressemblance, puis un libelle
# ecrit par un modele pour chaque groupe. Mettre TOPICS_AUTO=false desactive le declenchement
# automatique — le bouton « Recalculer » de l'ecran reste disponible.
TOPICS_AUTO=true
# TOPICS_CRON=0 30 3 * * *
# Fenetre analysee, en jours. **Changer cette valeur change le sens de la croissance affichee** :
# elle compare la seconde moitie de la fenetre a la premiere. Deux instantanes de fenetres
# differentes ne se comparent donc pas entre eux.
# TOPICS_WINDOW_DAYS=14

# Anomalies de volume (S7-J2).
# Detection toutes les 5 minutes : la mesure porte sur des heures pleines, mais mesurer souvent
# raccourcit le delai de signalement sans rien couter (aucun appel de modele). La contrainte
# d'unicite (V16) garantit qu'un meme pic n'est signale qu'une fois.
ALERTS_AUTO=true
# ALERTS_CRON=0 */5 * * * *
# Nombre d'heures examinees a chaque passage. > 1 = rattrapage apres un redemarrage : une anomalie
# manquee a bien eu lieu, et ne se rattrape pas toute seule (contrairement a un instantane de sujets).
# ALERTS_LOOKBACK=3
# Fenetre d'historique du detecteur, en heures. 336 = 14 jours, soit 14 observations par phase
# horaire — assez pour estimer une forme saisonniere de periode 24.
# ANOMALY_WINDOW_HOURS=336

# Risque de depassement SLA (S7-J3).
# Recalcul toutes les 10 minutes : le score vieillit par construction, sa variable dominante etant
# le temps restant avant echeance. 10 min = 2,5 % du budget le plus court (4 h pour une priorite
# haute). L'interface affiche la date du calcul plutot que de laisser croire a une valeur
# instantanee.
SLA_AUTO=true
# SLA_CRON=0 */10 * * * *
# Seuil de la file « a risque ». Decision d'exploitation et non propriete du modele : il fixe la
# taille de la file prioritaire et devrait se regler sur la capacite de l'equipe (ADR-0010).
# Volontairement global : si chacun reglait le sien, deux responsables parlant de « la file a
# risque » ne parleraient pas de la meme file.
SLA_AT_RISK_THRESHOLD=0.70

# Connecteur de boite aux lettres (S7-J4).
# **Desactive par defaut**, comme l'envoi de reponses : mal configure, il vide une vraie boite aux
# lettres en la marquant comme lue. Chaque courriel non lu devient un ticket (source EMAIL), avec
# nettoyage des reponses citees et de la signature. Le marquage « lu » est fait APRES creation du
# ticket : un plantage entre les deux produit au pire un doublon, jamais une perte silencieuse.
INTAKE_EMAIL_ENABLED=false
INTAKE_EMAIL_HOST=
INTAKE_EMAIL_PORT=993
INTAKE_EMAIL_USER=
INTAKE_EMAIL_PASSWORD=
INTAKE_EMAIL_FOLDER=INBOX
# INTAKE_EMAIL_CRON=0 */2 * * * *

# Envoi au client de la reponse validee par un agent.
# **false par defaut** : c'est la seule action qui atteint une personne exterieure, et elle ne se
# rattrape pas. En developpement, tout part vers Mailpit (voir SPRING_MAIL_HOST) — activer est donc
# sans risque tant que l'hote SMTP pointe sur Mailpit, et a ne PAS activer avec un vrai serveur.
REPLY_ENABLED=false
REPLY_FROM=support@localhost
# Serveur SMTP. `mailpit` est le nom du service Docker : les courriels sont captures et lisibles
# sur http://localhost:8025, jamais livres. Laisser **vide** desactive completement l'envoi.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
